# Redis (Cloud or local 8.x with the Query Engine). Also read from the workshop repo root .env.
REDIS_URL=redis://default:PASSWORD@HOST:PORT

# Optional: enables the tool-calling agent for Skills and LLM-written RAG answers / FAQ drafts.
# Without it the demo runs in offline mode (verbatim FAQs, deterministic Skill runner, quoted articles).
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# Redis Playbook location.
#   embedded (default when the IRIS_* values are empty): reference Playbook on REDIS_URL
#   remote: Redis Cloud Iris Agent Playbooks, via the official redis-iris SDK variable names below.
#           Copy the three values from the Playbook's Configuration page in the Redis Cloud console.
PLAYBOOK_MODE=auto
IRIS_AGENT_PLAYBOOKS_URL=
IRIS_AGENT_PLAYBOOKS_PLAYBOOK_ID=
IRIS_AGENT_PLAYBOOKS_API_KEY=
PLAYBOOK_NAME="StreamFlix Support"

# Redis Agent Memory. The agent recalls before answering and records each turn.
IRIS_AGENT_MEMORY_URL=
IRIS_AGENT_MEMORY_STORE_ID=
IRIS_AGENT_MEMORY_API_KEY=

# Publishing content with the `iris` CLI uses a separate content key, kept in .env.content:
#   IRIS_AGENT_PLAYBOOKS_CONTENT_API_KEY=

# Knowledge extraction: similar RAG-answered sessions needed before a FAQ proposal is filed
EXTRACTION_MIN_SESSIONS=3
